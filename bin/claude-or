#!/usr/bin/env bash
# Launch Claude Code against a free-model provider without touching the
# Anthropic-subscription `claude` profile.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null || echo 0.0.0)"
PROVIDERS_PY="$ROOT/lib/providers.py"
SYNC_SCRIPT="$ROOT/lib/sync_models.py"

load_provider() {
  if [[ -n "${1:-}" ]]; then
    eval "$(python3 "$PROVIDERS_PY" --dump-shell --provider "$1")"
  else
    eval "$(python3 "$PROVIDERS_PY" --dump-shell)"
  fi
  CONFIG_DIR="$PROVIDER_CONFIG_DIR"
  KEYCHAIN_SERVICE="$PROVIDER_KEY_SERVICE"
  KEYCHAIN_ACCOUNT="$PROVIDER_KEY_ACCOUNT"
  KEY_FILE="$PROVIDER_KEY_FILE"
}

load_provider

usage() {
  cat <<EOF
claude-or $VERSION — Claude Code on free models (OpenRouter / AIHubMix / ZenMux)

Usage:
  claude-or                 Start Claude Code with the active provider
  claude-or web             Local dashboard (127.0.0.1) for provider, models, quota
  claude-or use <provider>  Switch provider: openrouter | aihubmix | zenmux
  claude-or providers       List providers and which one is active
  claude-or sync            Refresh /model for the active provider
  claude-or probe           Same as sync
  claude-or key [provider]  Store that provider's API key (hidden input)
  claude-or key -           Read the key from stdin
  claude-or status          Profile, live/down counts, quota
  claude-or doctor          Check claude, python, key, catalog, quota
  claude-or update          git pull this install, then sync
  claude-or --version
  claude-or --help

Active provider: $PROVIDER_ID ($PROVIDER_NAME)
Claude Code profile: $PROVIDER_CONFIG_DIR
Regular \`claude\` is unchanged (Anthropic login / subscription).

One Claude Code session can only talk to one gateway. Switching providers
starts a different profile; it does not merge /model lists.

Setup:
  claude-or use openrouter && claude-or key    # https://openrouter.ai/settings/keys
  claude-or use aihubmix && claude-or key      # https://aihubmix.com
  claude-or use zenmux && claude-or key        # https://zenmux.ai
  claude-or
EOF
}

die() {
  printf 'claude-or: %s\n' "$*" >&2
  exit 1
}

on_macos() {
  [[ "$(uname -s)" == Darwin ]] && command -v security >/dev/null 2>&1
}

read_keychain() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w 2>/dev/null || true
}

read_keyfile() {
  if [[ -f "$KEY_FILE" ]]; then
    tr -d '\r\n' < "$KEY_FILE"
  fi
}

store_keychain() {
  local key="$1"
  security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w "$key" >/dev/null
  printf 'Stored %s key in Keychain (%s / %s)\n' "$PROVIDER_NAME" "$KEYCHAIN_SERVICE" "$KEYCHAIN_ACCOUNT"
}

store_keyfile() {
  local key="$1"
  mkdir -p "$(dirname "$KEY_FILE")"
  umask 077
  printf '%s\n' "$key" > "$KEY_FILE"
  chmod 600 "$KEY_FILE"
  printf 'Stored %s key in %s (mode 600)\n' "$PROVIDER_NAME" "$KEY_FILE"
}

normalize_key() {
  local key="$1"
  key="${key//$'\r'/}"
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key%"${key##*[![:space:]]}"}"
  printf '%s' "$key"
}

store_key() {
  local key
  key="$(normalize_key "$1")"
  [[ -n "$key" ]] || die "API key is empty"
  CLAUDE_OR_KEY_CHECK="$key" CLAUDE_OR_PROVIDER_ID="$PROVIDER_ID" PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" python3 -c '
import os, sys
from providers import get_provider, key_looks_valid
provider = get_provider(os.environ.get("CLAUDE_OR_PROVIDER_ID"))
key = os.environ.get("CLAUDE_OR_KEY_CHECK") or ""
if not key_looks_valid(provider, key):
    prefixes = " / ".join(provider.key_prefixes)
    sys.exit(f"{provider.name} keys start with {prefixes}")
'
  if on_macos; then
    store_keychain "$key"
  else
    store_keyfile "$key"
  fi
}

peek_key() {
  local key="${CLAUDE_OR_API_KEY:-}"
  if [[ -z "$key" && "$PROVIDER_ID" == openrouter ]]; then
    key="${OPENROUTER_API_KEY:-}"
  fi
  if [[ -z "$key" ]] && on_macos; then
    key="$(read_keychain)"
  fi
  if [[ -z "$key" ]]; then
    key="$(read_keyfile)"
  fi
  printf '%s' "$key"
}

resolve_key() {
  local key
  key="$(peek_key)"
  if [[ -z "$key" ]]; then
    cat >&2 <<EOF
claude-or: no $PROVIDER_NAME API key found.

Create one at $PROVIDER_SIGNUP
then store it:

  claude-or key $PROVIDER_ID
EOF
    exit 1
  fi
  printf '%s' "$key"
}

with_api_key() {
  local key
  key="$(peek_key)"
  if [[ -n "$key" ]]; then
    CLAUDE_OR_API_KEY="$key" OPENROUTER_API_KEY="$key" "$@"
  else
    "$@"
  fi
}

cmd_key() {
  local key=""
  if [[ "${1:-}" != "" && "${1:-}" != "-" ]]; then
    load_provider "$1"
    shift
  fi
  if [[ "${1:-}" == "-" ]]; then
    IFS= read -r key
  elif [[ -n "${1:-}" ]]; then
    die "Do not pass the key as an argument (it lands in shell history). Use: claude-or key [$PROVIDER_ID]"
  else
    printf 'Paste %s API key (input hidden): ' "$PROVIDER_NAME"
    IFS= read -rs key
    printf '\n'
  fi
  store_key "$key"
}

cmd_use() {
  [[ -n "${1:-}" ]] || die "usage: claude-or use openrouter|aihubmix|zenmux"
  python3 "$PROVIDERS_PY" --set "$1" >/dev/null
  load_provider
  printf 'Active provider: %s (%s)\n' "$PROVIDER_ID" "$PROVIDER_NAME"
  printf 'Profile:         %s\n' "$PROVIDER_CONFIG_DIR"
  printf 'Get a key:       %s\n' "$PROVIDER_SIGNUP"
  printf 'Then:            claude-or key && claude-or sync && claude-or\n'
}

cmd_providers() {
  python3 "$PROVIDERS_PY" --list
}

cmd_sync() {
  [[ -f "$SYNC_SCRIPT" ]] || die "missing $SYNC_SCRIPT"
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  CLAUDE_OR_HOME="$CONFIG_DIR" with_api_key python3 "$SYNC_SCRIPT" --provider "$PROVIDER_ID" --config-dir "$CONFIG_DIR" "$@"
}

ensure_profile() {
  if [[ ! -f "$CONFIG_DIR/settings.json" ]]; then
    printf 'claude-or: no %s profile yet, syncing free catalog…\n' "$PROVIDER_NAME" >&2
    cmd_sync
    return
  fi
  local state
  state="$(python3 "$SYNC_SCRIPT" --provider "$PROVIDER_ID" --config-dir "$CONFIG_DIR" --check-stale)"
  if [[ "$state" == stale ]]; then
    printf 'claude-or: %s catalog older than 24h, refreshing…\n' "$PROVIDER_NAME" >&2
    if ! cmd_sync --no-probe; then
      printf 'claude-or: refresh failed; launching with the existing profile\n' >&2
    fi
  fi
}

cmd_status() {
  local key_state="missing"
  if [[ -n "${CLAUDE_OR_API_KEY:-}" ]]; then
    key_state="env CLAUDE_OR_API_KEY"
  elif [[ "$PROVIDER_ID" == openrouter && -n "${OPENROUTER_API_KEY:-}" ]]; then
    key_state="env OPENROUTER_API_KEY"
  elif on_macos && [[ -n "$(read_keychain)" ]]; then
    key_state="keychain ${KEYCHAIN_SERVICE}/${KEYCHAIN_ACCOUNT}"
  elif [[ -n "$(read_keyfile)" ]]; then
    key_state="file $KEY_FILE"
  fi
  printf 'version:    %s\n' "$VERSION"
  printf 'install:    %s\n' "$ROOT"
  printf 'key:        %s\n' "$key_state"
  with_api_key python3 "$SYNC_SCRIPT" --provider "$PROVIDER_ID" --config-dir "$CONFIG_DIR" --print-status || true
}

cmd_doctor() {
  local ok=0
  check() {
    local name="$1" status="$2" detail="$3"
    if [[ "$status" == ok ]]; then
      printf 'ok   %s %s\n' "$name" "$detail"
    else
      printf 'fail %s %s\n' "$name" "$detail"
      ok=1
    fi
  }
  if command -v python3 >/dev/null 2>&1; then
    check python3 ok "$(python3 --version 2>&1)"
  else
    check python3 fail "not on PATH"
  fi
  if command -v claude >/dev/null 2>&1; then
    check claude ok "$(command -v claude)"
  else
    check claude fail "not on PATH — install Claude Code first"
  fi
  check provider ok "$PROVIDER_ID $PROVIDER_BASE_URL"
  if [[ -n "$(peek_key)" ]]; then
    check api-key ok "present"
  else
    check api-key fail "run: claude-or key $PROVIDER_ID"
  fi
  if python3 - "$PROVIDER_CATALOG_URL" <<'PY'
import json, sys, urllib.request
url = sys.argv[1]
req = urllib.request.Request(url, headers={"User-Agent": "claude-or/doctor", "Accept": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=20) as response:
        data = json.load(response)
    models = data.get("data") if isinstance(data, dict) else data
    print(len(models) if isinstance(models, list) else 0)
    sys.exit(0)
except Exception as exc:
    print(exc, file=sys.stderr)
    sys.exit(1)
PY
  then
    check catalog ok "$PROVIDER_CATALOG_URL"
  else
    check catalog fail "cannot fetch $PROVIDER_CATALOG_URL (proxy?)"
  fi
  if [[ "$PROVIDER_QUOTA" == openrouter-key ]]; then
    if [[ -n "$(peek_key)" ]]; then
      local quota_rc=0 quota_line
      quota_line="$(with_api_key python3 "$SYNC_SCRIPT" --provider "$PROVIDER_ID" --config-dir "$CONFIG_DIR" --print-quota)" || quota_rc=$?
      if [[ "$quota_rc" -eq 2 ]]; then
        check quota fail "$quota_line"
      elif [[ "$quota_rc" -ne 0 ]]; then
        check quota fail "could not read GET /api/v1/key"
      else
        check quota ok "$quota_line"
      fi
    else
      check quota fail "no API key — run: claude-or key"
    fi
  else
    check quota ok "$PROVIDER_NAME has no free-request counter API"
  fi
  return "$ok"
}

cmd_update() {
  [[ -d "$ROOT/.git" ]] || die "this install is not a git clone; re-run install.sh from a clone"
  git -C "$ROOT" pull --ff-only
  cmd_sync
}

cmd_web() {
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  [[ -f "$ROOT/lib/web.py" ]] || die "missing $ROOT/lib/web.py"
  PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 "$ROOT/lib/web.py" "$@"
}

cmd_launch() {
  local key claude_bin quota_rc=0 quota_line
  key="$(resolve_key)"
  ensure_profile
  [[ -f "$CONFIG_DIR/settings.json" ]] || die "missing settings.json — run: claude-or sync"

  if [[ "$PROVIDER_QUOTA" == openrouter-key ]]; then
    quota_line="$(CLAUDE_OR_API_KEY="$key" OPENROUTER_API_KEY="$key" python3 "$SYNC_SCRIPT" --provider "$PROVIDER_ID" --config-dir "$CONFIG_DIR" --print-quota)" || quota_rc=$?
    printf 'claude-or: %s\n' "${quota_line#quota:        }" >&2
    if [[ "$quota_rc" -eq 2 ]]; then
      printf 'claude-or: daily free-model quota is exhausted. Wait for UTC midnight, or buy \$10 credits once to raise the cap to 1000/day.\n' >&2
    fi
  else
    printf 'claude-or: %s (%s)\n' "$PROVIDER_NAME" "$PROVIDER_BASE_URL" >&2
  fi

  claude_bin="$(command -v claude)" || die "claude is not on PATH"
  mkdir -p "$CONFIG_DIR"

  export CLAUDE_CONFIG_DIR="$CONFIG_DIR"
  export CLAUDE_OR_API_KEY="$key"
  export OPENROUTER_API_KEY="$key"
  export ANTHROPIC_BASE_URL="$PROVIDER_BASE_URL"
  export ANTHROPIC_AUTH_TOKEN="$key"
  export ANTHROPIC_API_KEY=""
  export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY="${CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY:-1}"
  unset CLAUDE_CODE_OAUTH_TOKEN

  exec "$claude_bin" "$@"
}

main() {
  case "${1:-}" in
    -h|--help|help) usage ;;
    -v|--version|version) printf '%s\n' "$VERSION" ;;
    use) shift; cmd_use "${1:-}" ;;
    providers|provider) cmd_providers ;;
    key) shift; cmd_key "$@" ;;
    sync|probe) shift; cmd_sync "$@" ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    update) cmd_update ;;
    web|ui|dashboard) shift; cmd_web "$@" ;;
    *) cmd_launch "$@" ;;
  esac
}

main "$@"
